<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ticket_reply_as_pec_email_template" model="mail.template">
            <field name="name">Helpdesk: Reply as PEC</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="subject">Re: {{ object.display_name }}</field>
            <field name="email_from">{{ object.sudo().original_team_id.alias_email_from }}</field>
            <field name="email_to">{{ (object.partner_email if not object.sudo().partner_id.email or object.sudo().partner_id.email != object.partner_email else '') }}</field>
            <field name="partner_to">{{ object.partner_id.id if object.sudo().partner_id.email and object.sudo().partner_id.email == object.partner_email else '' }}</field>
            <field name="reply_to">{{ object.sudo().original_team_id.alias_name }}@{{ object.sudo().original_team_id.alias_domain }}</field>
            <field name="description">Set "email_from" and "reply_to" as Helpdesk Team Alias instead of "notifications@..."</field>
            <field name="body_html" type="html">
                <div>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang or object.user_id.lang or user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
